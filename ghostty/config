# === SHELL INTEGRATION ZSH 42 SESSION ===================#
command = zsh
shell-integration = zsh

# === FONT TYPE ==========================================#
font-family = "JetBrainsMono Nerd Font"
font-size = 12
font-thicken = true

# === THEME GLOBAL =======================================#
background-opacity = 0.85
background-blur-radius = 20
unfocused-split-opacity = 0.65
unfocused-split-fill = 400020
split-divider-color = FF007E

window-theme = auto
window-decoration = true
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true
confirm-close-surface = false

# --- HID ------------------------------------------------#
mouse-hide-while-typing

cursor-style-blink = false
#shell-integration-features = no-cursor

# --- Cursor shader works only on tip branch -------------#
auto-update = check
auto-update-channel = tip

# === MAC OS =============================================#
macos-titlebar-style = tabs
macos-icon = xray
macos-icon-ghost-color = 99b3ff
#macos-icon-frame = beige

#  === THEME =============================================#
theme = nepha

# === CURSOR ANIMATED ====================================#
#custom-shader = shaders/cursor_trail.glsl
#custom-shader = shaders/cursor_blaze.glsl

#custom-shader = shaders/cursor_blaze_tapered.glsl
#custom-shader = shaders/cursor_blaze.glsl
#custom-shader = shaders/cursor_blaze_frozen.glsl
custom-shader = shaders/cursor_wip_nepha.glsl
#custom-shader = shaders/manga_slash.glsl
custom-shader = shaders/cursor_smear.glsl

# === SHADERS T800 HUD ===================================#
#custom-shader = shaders/tft_nepha.glsl

# === SHADERS MATRIX WALL ================================#
#custom-shader = shaders/window_matrix.glsl

# === SHADERS SMOOTHIS LOFI ==============================#
custom-shader = shaders/window_bloom_nepha.glsl

# === SHADERS GLITCH NEPHA ===============================#
#custom-shader = shaders/window_glowglitchy.glsl

# === SHADERS ANIMATION ==================================#
custom-shader-animation = always
cursor-style = block

# === KEYBIND 42 SESSION MACOS BEHAVIOR ==================#

# Splits
keybind = alt+shift+d=new_split:right
keybind = alt+d=new_split:down
keybind = alt+w=close_surface

# Navigation splits
keybind = alt+left_bracket=goto_split:previous
keybind = alt+right_bracket=goto_split:next

# Onglets
keybind = alt+t=new_tab

# Fenêtre
keybind = alt+n=new_window

# Clipboard
keybind = alt+c=copy_to_clipboard
keybind = alt+v=paste_from_clipboard

